# Application Configuration
APP_NAME=Emergency Response Platform
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Database Configuration
# Local SQLite: sqlite:///./emergency_response.db
# Cloud PostgreSQL (Render, Neon, Supabase): postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./emergency_response.db

# Security & Authentication
# In production, generate a secure random 32+ character key (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-this-development-secret-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list or JSON array of authorized client origins. Use * for open access.
# Example: http://localhost:5173,https://your-signal-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional: Persistent Upload Directory (e.g., mounted disk on Render /var/data/uploads)
# UPLOAD_DIR=uploads/report_photos
